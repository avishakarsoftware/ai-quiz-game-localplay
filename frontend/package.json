{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "cap:gamma": "node scripts/cap-build.mjs gamma copy",
    "cap:sync:gamma": "node scripts/cap-build.mjs gamma sync",
    "cap:prod": "node scripts/cap-build.mjs prod copy",
    "cap:sync:prod": "node scripts/cap-build.mjs prod sync",
    "ionos:build": "node scripts/ionos-build.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:prod": "cd .. && .venv/bin/python scripts/regression.py --target prod",
    "test:gamma": "cd .. && .venv/bin/python scripts/regression.py --target gamma",
    "test:local": "cd .. && .venv/bin/python scripts/regression.py --target local",
    "test:e2e": "playwright test",
    "test:e2e:all-games": "PLAYWRIGHT_BASE_URL=http://127.0.0.1:9200 LIVE_API_BASE_URL=http://127.0.0.1:9100 playwright test e2e/all-games.spec.ts --project chromium-desktop --workers=4",
    "test:e2e:all-games:gamma": "PLAYWRIGHT_BASE_URL=https://gamesapi-gamma.revelryapp.me playwright test e2e/all-games.spec.ts --project chromium-desktop --workers=4",
    "test:e2e:gamma": "PLAYWRIGHT_BASE_URL=https://gamesapi-gamma.revelryapp.me playwright test e2e/gamma-smoke.spec.ts",
    "test:e2e:gamma:generic": "PLAYWRIGHT_BASE_URL=https://gamesapi-gamma.revelryapp.me playwright test e2e/generic-prompt-gamma-live.spec.ts --project chromium-desktop --workers=1",
    "test:e2e:gamma:revelry": "PLAYWRIGHT_BASE_URL=https://gamesapi-gamma.revelryapp.me playwright test e2e/revelry-gamma-flow.spec.ts --project chromium-desktop",
    "test:e2e:preprod-live": "playwright test e2e/preprod-live-regression.spec.ts --project chromium-desktop --workers=1",
    "test:e2e:preprod-revelry": "PLAYWRIGHT_BASE_URL=https://gamesapi-gamma.revelryapp.me playwright test e2e/revelry-preprod-live.spec.ts e2e/revelry-party-quests-staging.spec.ts --project chromium-desktop --workers=1",
    "test:e2e:preprod-ux": "playwright test e2e/preprod-live-ux-audit.spec.ts --project chromium-desktop --workers=1",
    "test:e2e:visual": "../scripts/visual-regression.sh",
    "test:e2e:visual:update": "../scripts/visual-regression.sh --update-snapshots"
  },
  "dependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@capacitor/haptics": "^8.0.1",
    "@capacitor/ios": "^8.1.0",
    "@capacitor/share": "^8.0.1",
    "@revenuecat/purchases-capacitor": "^12.3.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "posthog-js": "^1.352.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@capgo/capacitor-social-login": "^8.3.9",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.18"
  }
}
